VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

VITE_FEATHERLESS_API_KEY=your-featherless-api-key

# ── Provider ────────────────────────────────────────────────────
# Default is Featherless. For OpenRouter, set:
#   VITE_AI_BASE_URL=https://openrouter.ai/api/v1
#   VITE_OPENROUTER_API_KEY=your-openrouter-key
#   VITE_FEATHERLESS_MODEL=qwen/qwen-2.5-7b-instruct   (non-thinking model)
# A generic VITE_AI_API_KEY overrides both providers.
VITE_AI_BASE_URL=https://api.featherless.ai/v1
VITE_AI_API_KEY=

# Optional: override the model. Defaults to Qwen/Qwen3-1.7B (fastest open).
# Featherless picks: Qwen/Qwen3-1.7B | Qwen/Qwen2.5-7B-Instruct | Qwen/Qwen3-8B
# OpenRouter picks:   qwen/qwen-2.5-7b-instruct | meta-llama/llama-3.1-8b-instruct
VITE_FEATHERLESS_MODEL=Qwen/Qwen3-1.7B
