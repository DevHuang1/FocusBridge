# Firebase web config (from Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# AI provider. OpenRouter is the default. For Featherless instead, set:
#   VITE_AI_BASE_URL=https://api.featherless.ai/v1
#   VITE_FEATHERLESS_API_KEY=your-featherless-key
#   VITE_OPENROUTER_MODEL=Qwen/Qwen3-1.7B   (Featherless also accepts chat_template_kwargs)
# A generic VITE_AI_API_KEY overrides both providers.
VITE_AI_BASE_URL=https://openrouter.ai/api/v1
VITE_OPENROUTER_API_KEY=
VITE_AI_API_KEY=

# Optional: override the model. Defaults to qwen/qwen-2.5-7b-instruct.
# OpenRouter picks: qwen/qwen-2.5-7b-instruct | meta-llama/llama-3.1-8b-instruct
# Featherless picks: Qwen/Qwen3-1.7B | Qwen/Qwen2.5-7B-Instruct | Qwen/Qwen3-8B
VITE_OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct

# Optional: route AI calls through the Firebase Cloud Function so the API
# key stays server-side. Set to the deployed URL, e.g.
#   https://us-central1-<project>.cloudfunctions.net
# The function reads AI_API_KEY / AI_BASE_URL / AI_MODEL from its own env.
# VITE_FIREBASE_FUNCTIONS_URL=

# ── Demo account (one-touch login on the auth screen) ─────────────
# Defaults to demo@focusbridge.app / demo-pass-2026. Override to point
# at a different seeded demo account.
# VITE_DEMO_USER_EMAIL=demo@focusbridge.app
# VITE_DEMO_USER_PASSWORD=demo-pass-2026

# ── Firebase Admin SDK (seeding scripts only, never used in the client) ──
# Path to the service-account JSON downloaded from Project settings →
# Service accounts. Used by `npm run demo:setup` and `npm run demo:activity`.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/serviceAccountKey.json